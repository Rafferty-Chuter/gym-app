# Copy to .env.local (gitignored). Never commit real keys.

# Required: the assistant, memory extraction and food parsing call the Anthropic API.
ANTHROPIC_API_KEY=

# Optional: only /api/refine-target uses OpenAI. Leave blank to disable that call.
OPENAI_API_KEY=

# Optional: feedback link shown in Profile and the assistant.
NEXT_PUBLIC_TALLY_FEEDBACK_URL=

# Apple Health auto-upload (Health Auto Export → /api/ingest/hae). Server only; never NEXT_PUBLIC_.
# Create the tables with supabase/migrations/0001_health.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reminders (web push, Sprint 0 G5). Make the pair once with `npx web-push generate-vapid-keys`.
# The public key is read by the browser (NEXT_PUBLIC_); the private key and the cron secret are server only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://gym-app-eta-nine.vercel.app
# Shared with the hourly scheduler in supabase/migrations/0002_push.sql (any long random string).
CRON_SECRET=
