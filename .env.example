# Copy to .env.local (gitignored). Never commit real keys.

# Required: the assistant, memory extraction and food parsing call the Anthropic API.
ANTHROPIC_API_KEY=

# Optional: only /api/refine-target uses OpenAI. Leave blank to disable that call.
OPENAI_API_KEY=

# Optional: feedback link shown in Profile and the assistant.
NEXT_PUBLIC_TALLY_FEEDBACK_URL=

# Apple Health auto-upload (Health Auto Export → /api/ingest/hae). Server only; never NEXT_PUBLIC_.
# Create the tables with supabase/migrations/0001_health.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
